{
  "note": "Second attempt at R2 and C2-e. First attempt failed to reproduce both, and the reason was mine, not the reporters': (a) my import.meta line had no LATER `from '…'` clause to swallow forward to, so nothing was blanked; (b) my C2-e omitted the unicode escape, which is what CF-2 says isolates R7 as the only per-file rule the shrink removes.",
  "cases": [
    {
      "id": "CTRL-0",
      "control": true,
      "desc": "no-op comment — MUST be GREEN",
      "expect": "GREEN",
      "edits": [
        {
          "file": "web/src/util/markdown.ts",
          "find": "export function renderMarkdown(md: string): string {",
          "replace": "// no-op control mutation\nexport function renderMarkdown(md: string): string {"
        }
      ]
    },
    {
      "id": "R2-importmeta",
      "desc": "R2 verbatim: laundering file prepends import.meta above the value alias, with a later `from` clause for the match to run to",
      "expect": "GREEN",
      "tsc": true,
      "edits": [
        {
          "file": "web/src/components/inspector/inspector-shared-styles.ts",
          "find": "import { css } from 'lit';",
          "replace": "import { unsafeHTML } from 'lit/directives/unsafe-html.js';\nconst dev = import.meta.env.DEV\nexport const rawHtml = unsafeHTML\nexport { css as _css } from 'lit';\nimport { css } from 'lit';"
        },
        {
          "file": "web/src/components/inspector/ft-inspector-desc.ts",
          "find": "import { renderMarkdown } from '../../util/markdown.js';",
          "replace": "import { renderMarkdown } from '../../util/markdown.js';\nimport { rawHtml } from './inspector-shared-styles.js';"
        },
        {
          "file": "web/src/components/inspector/ft-inspector-desc.ts",
          "find": "        ${unsafeHTML(renderMarkdown(this.description))}",
          "replace": "        ${unsafeHTML(renderMarkdown(this.description))}\n        ${rawHtml(this.description)}"
        }
      ]
    },
    {
